# =============================================================================
# KG-RAG 环境变量配置模板
# 复制此文件为 .env，按需填写后启动服务
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# 一、LLM 服务（文本推理）
# ─────────────────────────────────────────────────────────────────────────────

# 运行模式：api（调用云端 API）| local（本地 Ollama）
LLM_MODE=api

# 提供方（LLM_MODE=api 时生效）：
#   qwen      → 通义千问（需填 DASHSCOPE_API_KEY）
#   deepseek  → DeepSeek API（需填 DEEPSEEK_API_KEY）
#   ernie     → 文心一言（需填 ERNIE_API_KEY + ERNIE_SECRET_KEY）
#   anthropic → Anthropic Claude（需填 LLM_API_KEY）
#   ""        → 通用 OpenAI 兼容端点（需填 LLM_API_URL + LLM_API_KEY + LLM_MODEL）
LLM_PROVIDER=qwen

# 通用 OpenAI 兼容端点配置（LLM_PROVIDER="" 时使用，也兼容旧版配置）
LLM_API_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# 各提供方专用模型名（留空则使用括号内的默认值）
LLM_QWEN_MODEL=qwen-plus          # 可选：qwen-max / qwen-turbo / qwen-plus
LLM_DEEPSEEK_MODEL=deepseek-chat  # 可选：deepseek-chat / deepseek-reasoner
LLM_ERNIE_MODEL=ernie-4.5-8k     # 可选：ernie-4.0-8k / ernie-speed-128k

# 各提供方 API Key
DASHSCOPE_API_KEY=                # 通义千问 / 通义文本向量 通用密钥（https://dashscope.aliyun.com）
DEEPSEEK_API_KEY=                 # DeepSeek API 密钥（https://platform.deepseek.com）
ERNIE_API_KEY=                    # 文心一言 API Key（百度 AI 开放平台）
ERNIE_SECRET_KEY=                 # 文心一言 Secret Key


# ─────────────────────────────────────────────────────────────────────────────
# 二、LLM 本地模式（LLM_MODE=local 时生效，通过 Ollama 调用）
# ─────────────────────────────────────────────────────────────────────────────

# 提供方（local 模式）：
#   qwen      → 本地 Qwen2.5（推荐 7B/14B）
#   deepseek  → 本地 DeepSeek-R1
#   ""        → 使用 OLLAMA_MODEL 指定的任意模型
# LLM_PROVIDER=qwen

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b            # LLM_PROVIDER="" 时使用此模型

# 各提供方在 Ollama 中的模型名（留空则使用括号内的默认值）
LOCAL_LLM_QWEN_MODEL=qwen2.5:7b       # 可选：qwen2.5:14b / qwen2.5:32b
LOCAL_LLM_DEEPSEEK_MODEL=deepseek-r1:7b  # 可选：deepseek-r1:14b / deepseek-r1:32b


# ─────────────────────────────────────────────────────────────────────────────
# 三、Embedding 服务（文本向量化）
# ─────────────────────────────────────────────────────────────────────────────

# 运行模式：local（本地 bge-m3，默认）| api（调用云端 Embedding API）
EMBEDDING_MODE=local

# 提供方（EMBEDDING_MODE=api 时生效）：
#   qwen → 通义文本向量 text-embedding-v3（需填 DASHSCOPE_API_KEY）
#   ""   → 通用 OpenAI 兼容 Embedding API（需填 EMBEDDING_API_URL/KEY/MODEL）
EMBEDDING_PROVIDER=

# 本地模式：bge-m3 模型路径（相对于 backend/ 目录）
EMBEDDING_MODEL=models/bge-m3

# 通用 API 模式配置（EMBEDDING_PROVIDER="" 时使用）
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-ada-002  # API 模式下覆盖模型名

# 通义文本向量专用配置（EMBEDDING_PROVIDER=qwen 时使用）
EMBEDDING_QWEN_MODEL=text-embedding-v3   # 可选：text-embedding-v1（维度 1536）
EMBEDDING_QWEN_DIM=1024                  # text-embedding-v3 默认 1024 维


# ─────────────────────────────────────────────────────────────────────────────
# 四、视觉语言模型 VLM（图片/图纸/公式分析）
# ─────────────────────────────────────────────────────────────────────────────

# 运行模式：api（云端 VLM，默认）| local（本地 VLM）
VISION_MODE=api

# API 模式优先级：DASHSCOPE_API_KEY → ERNIE_API_KEY → HUNYUAN_API_KEY（自动降级）
# 各 Key 已在上方填写，此处无需重复

# 通义千问 VL 模型名（VISION_MODE=api 时）
QWEN_VL_MODEL=qwen-vl-max         # 可选：qwen-vl-plus / qwen2-vl-72b-instruct

# 混元 VL（腾讯云，可选第三备用）
HUNYUAN_API_KEY=

# 本地 VLM 路径（VISION_MODE=local 时，优先 Qwen2-VL，备用 InternVL2）
LOCAL_VLM_PATH=models/qwen2-vl          # 主选：Qwen2-VL（transformers 加载）
LOCAL_VLM_BACKUP_PATH=models/internvl2  # 备用：InternVL2

# VLM 文本生成所用模型名（analyze_image / drawing_analyzer 降级路径使用）
VLM_MODEL=Qwen/Qwen2.5-VL-32B-Instruct


# ─────────────────────────────────────────────────────────────────────────────
# 五、数据库与存储
# ─────────────────────────────────────────────────────────────────────────────

# Neo4j 知识图谱
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aviation123

# Milvus 向量数据库
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Redis 缓存（语义缓存 / 查询缓存 / 速率限制）
REDIS_URL=redis://localhost:6379/0
QUERY_CACHE_TTL=3600               # 查询缓存过期时间（秒）
SEMANTIC_CACHE_LOOKUP_TIMEOUT=1.0   # 语义缓存 embedding 预检超时（秒）
CLARIFICATION_ENABLED=true         # 问题模糊时是否主动澄清
CLARIFICATION_MIN_LENGTH=8         # 低于此长度的问题直接判定为过短
CLARIFICATION_LLM_CHECK=false      # 是否启用 LLM 进一步判断模糊度

# PostgreSQL 关系数据库（用户、会话、审计日志等）
DATABASE_URL=postgresql+asyncpg://aviation:aviation123@localhost:5432/aviation

# Elasticsearch 全文检索
ES_URL=http://localhost:9200

# MinIO 对象存储（文档原文 / 图片）
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost:9000


# ─────────────────────────────────────────────────────────────────────────────
# 六、应用基础配置
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development                # development | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
DEBUG=false
APP_VERSION=1.0.0

FRONTEND_URL=http://localhost:3000

# JWT 鉴权（生产环境务必替换为随机长字符串）
JWT_SECRET=aviation-jwt-secret-change-in-production
JWT_EXPIRE_HOURS=24


# ─────────────────────────────────────────────────────────────────────────────
# 七、可观测性（可选）
# ─────────────────────────────────────────────────────────────────────────────

# Langfuse LLM 调用追踪（留空则跳过）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001


# ─────────────────────────────────────────────────────────────────────────────
# 八、Reranker 重排序模型
# ─────────────────────────────────────────────────────────────────────────────

# 运行模式：local（本地 bge-reranker，默认）| api（OpenAI 兼容 Reranker API）
# ─────────────────────────────────────────────────────────────────────────────
# 九、告警推送（钉钉 / 企业微信）
# ─────────────────────────────────────────────────────────────────────────────

# 钉钉自定义机器人 Webhook（留空则不推送）
DINGTALK_WEBHOOK=
# 企业微信群机器人 Webhook（留空则不推送）
WECOM_WEBHOOK=
# 同类告警冷却时间（分钟）：同一告警标题在此期间内只发一次
ALERT_COOLDOWN_MINUTES=30


# ─────────────────────────────────────────────────────────────────────────────
# 十、Reranker 重排序模型
# ─────────────────────────────────────────────────────────────────────────────

RERANKER_MODE=local
RERANKER_MODEL=models/bge-reranker-v2-m3
# 领域微调后切换到本地微调模型（运行 scripts/finetune_reranker.py 后）：
# RERANKER_MODEL=models/reranker-cps-finetuned
RERANKER_API_URL=
RERANKER_API_KEY=
RERANKER_ENABLED=true
RERANKER_TOP_K=5
RERANKER_CANDIDATE_K=20


# ─────────────────────────────────────────────────────────────────────────────
# 十一、运维配置（模块C）
# ─────────────────────────────────────────────────────────────────────────────

# 日志输出格式：text（人类可读）| json（容器/日志聚合）
LOG_FORMAT=text

# 请求体大小限制（字节）：默认 100MB
MAX_REQUEST_BODY_BYTES=104857600

# 备份保留天数（cron-backup.sh 使用）
BACKUP_RETENTION_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# 十二、LLM 故障转移（模块C）
# 当主 LLM 不可用时自动切换到备用端点
# ─────────────────────────────────────────────────────────────────────────────
LLM_FAILOVER_ENABLED=false
LLM_FALLBACK_1_URL=
LLM_FALLBACK_1_KEY=
LLM_FALLBACK_1_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# 十三、私有化部署安全（模块 I）
# ─────────────────────────────────────────────────────────────────────────────

# 部署模式：cloud | hybrid | intranet | airgapped
DEPLOYMENT_MODE=cloud

# 密钥存储后端：file | vault | env
KEY_STORE_BACKEND=file

# 密钥文件路径（留空使用 backend/keys/keystore.json）
KEY_STORE_PATH=

# HashiCorp Vault（KEY_STORE_BACKEND=vault 时生效）
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_MOUNT=secret

# 字段级加密主密钥（32字节 base64，留空则禁用字段加密）
FIELD_ENCRYPTION_KEY=
